# Docker Compose
AIRFLOW_PROJ_DIR=.
ENV_FILE_PATH=.env

# Set to the host UID used for Airflow file ownership.
AIRFLOW_UID=50000

# Airflow secrets — generate your own values.
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Initial Airflow administrator
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=

# Python imports and temporary ingestion files inside containers
PYTHONPATH=/opt/airflow/include
DATA_DIR=/opt/airflow/data

# AWS
# On EC2, authentication uses the attached IAM role.
AWS_DEFAULT_REGION=
S3_BUCKET=

# Databricks
DATABRICKS_JOB_ID=
AIRFLOW_CONN_DATABRICKS_DEFAULT=

# Dependencies are installed when building the Docker image.
_PIP_ADDITIONAL_REQUIREMENTS=